# Local only - copy to .env, never commit .env.

# Passphrase that decrypts the passwords in data/testcredentials.json (required).
# In CI it is the repository secret CREDENTIALS_KEY.
CREDENTIALS_KEY=

# Optional - defaults shown
BASE_URL=https://eventhub.rahulshettyacademy.com
API_BASE_URL=https://api.eventhub.rahulshettyacademy.com/api

# Number of parallel workers (default 4, one test account per worker). WORKERS=1 for a serial run.
# WORKERS=4

# Watch the browser locally (default is headless; SLOW_MO is a delay in ms per action)
# HEADLESS=false
# SLOW_MO=500