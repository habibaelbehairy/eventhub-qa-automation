{
  "name": "eventhub-qa-automation",
  "version": "1.0.0",
  "description": "Playwright + TypeScript UI and API automation for EventHub story US-114 (book tickets for an event)",
  "main": "playwright.config.ts",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:xfail": "playwright test --grep @xfail --reporter=list",
    "report": "playwright show-report",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "npm run typecheck && npm run lint",
    "cleanup": "playwright test --config cleanup.config.ts",
    "credentials:encrypt": "tsx scripts/credentials.ts encrypt",
    "credentials:decrypt": "tsx scripts/credentials.ts decrypt"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.2"
  }
}
